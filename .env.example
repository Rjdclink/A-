# Node >=22.16, single-worker SQLite process; never commit real values.
PORT=3000
HOST=127.0.0.1
DB_PATH=data/a-plus.sqlite
RETENTION_DAYS=180
MAX_EVENTS=500000
ADMIN_TOKEN=replace-with-long-random-secret-32-characters
INGEST_TOKEN=replace-with-DIFFERENT-random-32-char-secret
# Must remain unchanged across restarts to preserve pseudonym joins and privacy erasure.
PSEUDONYM_KEY=replace-with-STABLE-secret-of-at-least-32-characters
# Optional tenant-specific roles: WORKSPACES_JSON={"default":{"adminToken":"...","ingestToken":"..."}}
WORKSPACES_JSON=
# Same Vireonix auto provider as GrowthVeyra AI.
AI_BASE_URL=https://vireonix.ai/v1/chat/completions
AI_MODEL=auto
AI_API_KEY=
# Shopify webhook receiver is optional and not an approved Shopify public app.
SHOPIFY_SECRET=
SHOPIFY_SHOPS_JSON=
# Enable only after the merchant documents an appropriate legal basis and privacy disclosure.
SHOPIFY_ANALYTICS_BASIS_ACKNOWLEDGED=false

# Manual integrity-checked backup: npm run backup
BACKUP_DIR=data/backups
BACKUP_RETAIN=7

# Customer support: separate from commerce analytics. Default deterministic answers only.
SUPPORT_AI_ENABLED=false
# Enable only after merchant verifies provider/data-processing arrangements and notices.
SUPPORT_AI_DATA_PROCESSING_ACKNOWLEDGED=false
SUPPORT_RETENTION_DAYS=180
# Example: {"default":["https://merchant.example"]}; strict HTTPS origins, no paths.
SUPPORT_EMBED_ORIGINS_JSON=
